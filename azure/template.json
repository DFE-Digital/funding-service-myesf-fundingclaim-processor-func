{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "resourceEnvironmentName": {
            "type": "string",
            "metadata": {
                "description": "Short name of the environment. Used for the name of resources created."
            }
        },
        "serviceName": {
            "type": "string",
            "metadata": {
                "description": "Short name of the service. Used for the name of resources created."
            }
        },
        "aspSize": {
            "type": "string",
            "defaultValue": "1"
        },
        "aspInstances": {
            "type": "int",
            "defaultValue": 1
        },
        "aspTier": {
            "type": "string",
            "defaultValue": "Basic"
        },
        "sharedResourceGroupName": {
            "type": "string"
        },
        "sharedAppInsightsName": {
            "type": "string"
        },
        "sharedStorageAccountName": {
            "type": "string"
        },
        "sharedKeyVaultName": {
            "type": "string"
        },
        "authenticationClientId": {
            "type": "string"
        },        
        "authenticationAppIdUrl": {
            "type": "string"
        },
        "fundingClaimDataApiUrl": {
            "type": "string"
        },
        "dataCollectionsApiBaseUri": {
            "type": "string"
        },
        "dataCollectionsApiTenantPath": {
            "type": "string"
        },
        "dataCollectionsApiClientId": {
            "type": "string"
        },        
        "dataCollectionsApiScope": {
            "type": "string"
        },
        "reconciliationFeedReaderScheduleTriggerTime": {
            "type": "string",
            "defaultValue": "0 7,17,27,37,47,57 * * * *"
        },
        "fCSApiEndpointSettingsBaseUri": {
            "type": "string",
            "defaultValue": ""
        },
        "fCSApiSettingsAppIdUri": {
            "type": "string",
            "defaultValue": ""
        },
        "fCSApiSettingsTenantId": {
            "type": "string",
            "defaultValue": ""
        },
        "fCSApiSettingsClientId": {
            "type": "string",
            "defaultValue": ""
        }        
    },
    "variables": {
        "deploymentUrlBase": "https://raw.githubusercontent.com/SkillsFundingAgency/funding-platform-building-blocks/master/templates/",
        "resourceNamePrefix": "[toLower(concat('pds-', parameters('resourceEnvironmentName'),'-', parameters('serviceName')))]",
        "functionAppName": "[concat(variables('resourceNamePrefix'), 'wkr-fa')]",
        "appServicePlanName": "[concat(variables('resourceNamePrefix'), 'wkr-asp')]"
    },
    "resources": [
        {
            "apiVersion": "2017-05-10",
            "name": "app-service-plan",
            "type": "Microsoft.Resources/deployments",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(variables('deploymentUrlBase'),'app-service-plan.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "appServicePlanName": {
                        "value": "[variables('appServicePlanName')]"
                    },
                    "aspSize": {
                        "value": "[parameters('aspSize')]"
                    },
                    "aspInstances": {
                        "value": "[parameters('aspInstances')]"
                    },
                    "nonASETier": {
                        "value": "[parameters('aspTier')]"
                    }
                }
            }
        },
        {
            "apiVersion": "2017-05-10",
            "name": "function-app",
            "type": "Microsoft.Resources/deployments",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(variables('deploymentUrlBase'),'function-app.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "functionAppName": {
                        "value": "[variables('functionAppName')]"
                    },
                    "appServicePlanName": {
                        "value": "[variables('appServicePlanName')]"
                    },
                    "appServicePlanResourceGroup": {
                        "value": "[resourceGroup().name]"
                    },
                    "functionAppAppSettings": {
                        "value": [
                            {
                                "name": "Environment",
                                "value": "[parameters('resourceEnvironmentName')]"
                            },
                            {
                                "name": "AzureWebJobsStorage",
                                "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('sharedStorageAccountName'),';AccountKey=',listKeys(resourceId(parameters('sharedResourceGroupName'),'Microsoft.Storage/storageAccounts',parameters('sharedStorageAccountName')), providers('Microsoft.Storage', 'storageAccounts').apiVersions[0]).keys[0].value, ';EndpointSuffix=core.windows.net')]"
                            },
                            {
                                "name": "FUNCTIONS_EXTENSION_VERSION",
                                "value": "~4"
                            },
                            {
                                "name": "FUNCTIONS_WORKER_RUNTIME",
                                "value": "dotnet-isolated"
                            },
                            {
                                "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                                "value": "[reference(resourceId(parameters('sharedResourceGroupName'), 'microsoft.insights/components', parameters('sharedAppInsightsName')),'2015-05-01').InstrumentationKey]"
                            },
                            {
                                "name": "PdsApplicationInsights:InstrumentationKey",
                                "value": "[reference(resourceId(parameters('sharedResourceGroupName'), 'microsoft.insights/components', parameters('sharedAppInsightsName')),'2015-05-01').InstrumentationKey]"
                            },
                            {
                                "name": "PdsApplicationInsights:Environment",
                                "value": "[parameters('resourceEnvironmentName')]"
                            },
                            {
                                "name": "GetFundingClaimScheduleTriggerTime",
                                "value": "0 1,11,21,31,41,51 * * * *"
                            },
                            {
                                "name": "UpdateFundingClaimWindowScheduleTriggerTime",
                                "value": "0 0,10,20,30,40,50 * * * *"
                            },
                            {
                                "name": "AutowithdrawFundingClaimScheduleTriggerTime",
                                "value": "0 5,15,25,35,45,55 * * * *"
                            },
                            {
                                "name": "InternalApiSettings:BaseUri",
                                "value": "[parameters('fundingClaimDataApiUrl')]"
                            },
                            {
                                "name": "FundingClaimApiSettings:Authority",
                                "value": "https://login.microsoftonline.com/"
                            },
                            {
                                "name": "FundingClaimApiSettings:TenantId",
                                "value": "[subscription().tenantId]"
                            },
                            {
                                "name": "FundingClaimApiSettings:ClientId",
                                "value": "[parameters('authenticationClientId')]"
                            },
                            {
                                "name": "FundingClaimApiSettings:ClientSecret",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'), ';SecretName=FundingClaimsDataApiSecret)')]"
                            },
                            {
                                "name": "FundingClaimApiSettings:AppIdUri",
                                "value": "[parameters('authenticationAppIdUrl')]"
                            },
                            {
                                "name": "DataCollectionApiEndpointSettings:BaseUri",
                                "value": "[parameters('dataCollectionsApiBaseUri')]"
                            },
                            {
                                "name": "DataCollectionApiEndpointSettings:GetFundingClaimCollectionsDetailsEndpoint",
                                "value": "FundingClaims/collections"
                            },
                            {
                                "name": "DataCollectionApiEndpointSettings:GetFundingClaimsEndpoint",
                                "value": "FundingClaims/submissions"
                            },
                            {
                                "name": "DataCollectionApiSettings:Authority",
                                "value": "https://login.microsoftonline.com/"
                            },
                            {
                                "name": "DataCollectionApiSettings:TenantId",
                                "value": "[parameters('dataCollectionsApiTenantPath')]"
                            },
                            {
                                "name": "DataCollectionApiSettings:ClientId",
                                "value": "[parameters('dataCollectionsApiClientId')]"
                            },
                            {
                                "name": "DataCollectionApiSettings:ClientSecret",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'), ';SecretName=DataCollectionApiSettingsClientSecret)')]"
                            },
                            {
                                "name": "DataCollectionApiSettings:Scope",
                                "value": "[parameters('dataCollectionsApiScope')]"
                            },
                            {
                                "name": "ReconciliationFeedReaderScheduleTriggerTime",
                                "value": "[parameters('reconciliationFeedReaderScheduleTriggerTime')]"
                            },
                            {
                                "name": "FCSApiEndpointSettings:BaseUri",
                                "value": "[parameters('fCSApiEndpointSettingsBaseUri')]"
                            },
                            {
                                "name": "FCSApiSettings:Authority",
                                "value": "https://login.microsoftonline.com/"
                            },
                            {
                                "name": "FCSApiSettings:AppIdUri",
                                "value": "[parameters('fCSApiSettingsAppIdUri')]"
                            },
                            {
                                "name": "FCSApiSettings:TenantId",
                                "value": "[parameters('fCSApiSettingsTenantId')]"
                            },
                            {
                                "name": "FCSApiSettings:ClientId",
                                "value": "[parameters('fCSApiSettingsClientId')]"
                            },
                            {
                                "name": "FCSApiSettings:ClientSecret",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'), ';SecretName=FcsApiSettingsClientSecret)')]"
                            }
                        ]
                    }
                }
            },
            "dependsOn": [
                "app-service-plan"
            ]
        }
    ],
    "outputs": {
        "FunctionAppName": {
            "type": "string",
            "value": "[variables('functionAppName')]"
        }
    }
}
