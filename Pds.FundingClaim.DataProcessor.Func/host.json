{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "functionTimeout": "00:59:00",
  "Logging": {
    "ApplicationInsights": {
        "logLevel": {
            "default": "Information",
            "Microsoft": "Warning",
            "Azure.Core": "Warning",
            "Azure.Messaging.ServiceBus": "Warning"
        },
        "samplingSettings": {
            "isEnabled": true,
            "excludedTypes": "Request"
        }
    }
  }
}